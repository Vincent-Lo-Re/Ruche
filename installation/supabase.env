# Réglages en ligne de la démo de Ruche (projet Supabase lnhjalrrvbokxwimmfxx), lus par
# `supabase config push` à la place des valeurs locales de supabase/config.toml : chaque
# SUPABASE_<SECTION>_<CLÉ> remplace la clé correspondante (auth.site_url → SUPABASE_AUTH_SITE_URL).
# Une liste s'écrit sur une ligne, séparée par des virgules. Aucun secret ici.
# Procédure : installation/README.md.

# L'admin en ligne : les liens des e-mails (invitation, code) y mènent.
# À compléter quand le projet Vercel de la démo existe.
SUPABASE_AUTH_SITE_URL=
# L'admin en ligne et les adresses de test créées par Vercel pour chaque demande de fusion.
SUPABASE_AUTH_ADDITIONAL_REDIRECT_URLS=

# Délai minimal entre deux e-mails pour une même personne (1 s en local, pour les tests).
SUPABASE_AUTH_EMAIL_MAX_FREQUENCY=60s
# En ligne, on garde la confirmation des adresses (réglage d'origine d'un projet).
SUPABASE_AUTH_EMAIL_ENABLE_CONFIRMATIONS=true
